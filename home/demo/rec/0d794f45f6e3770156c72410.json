{"ok":true,"domain":"garden-diary","view":{"today":"2026-10-16","lines":[{"id":"log-031","text":"Leeks still standing under the canvas. They will be good until Christmas.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-10-12","writtenAt":"2026-10-12T22:10:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-029","text":"Dahlias lifted, washed and drying upside down in the cellar before they go in the crates of peat.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-10-07","writtenAt":"2026-10-07T20:40:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"kg-dahlia","plantingTitle":"Dahlia","plantingLifted":true,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-028","text":"Garlic in along the south wall, four rows, one hundred and twelve cloves of Music.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-10-04","writtenAt":"2026-10-04T21:05:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":"kg-bed-wall","bedName":null,"bedKind":"bed","plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-027","text":"Thirty five at dawn and the dahlia leaves blackened at the edges. Lifting them this week.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-10-02","writtenAt":"2026-10-02T11:25:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-025","text":"Started the list of what to do before the frost.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-09-20","writtenAt":"2026-09-20T23:20:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-024","text":"Squash in. Curing on the porch in the sun for a fortnight.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-09-15","writtenAt":"2026-09-15T21:30:00.001Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"kg-butternut","plantingTitle":"Butternut squash","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-022","text":"First cool morning, fifty one at six. The cosmos does not mind.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-09-02","writtenAt":"2026-09-02T11:40:00.000Z","change