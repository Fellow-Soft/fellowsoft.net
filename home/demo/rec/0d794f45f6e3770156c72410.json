Name":null,"bedKind":null,"plantingId":"kg-dahlia","plantingTitle":"Dahlia","plantingLifted":true,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-016","text":"The third day over ninety. Watered everything at dusk and the squash leaves stood up again.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-07-24","writtenAt":"2026-07-25T01:10:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-015","text":"Japanese beetles on the zinnias. Knocked them into soapy water before breakfast.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-07-20","writtenAt":"2026-07-20T11:15:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-014","text":"Lettuces out, they had bolted. Carrots and leeks have the bed to themselves.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-07-16","writtenAt":"2026-07-16T22:20:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":"kg-bed-roots","bedName":null,"bedKind":"bed","plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"h