ision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":"kg-bed-roots","bedName":null,"bedKind":"bed","plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}}],"more":true,"next":"2026-05-18~2026-05-18T22:05:00.001Z~log-003","permissions":{"write":false,"private":false},"narrowed":{"garden":null,"bed":null,"planting":null,"houseplant":null,"hand":null}}}