{"ok":true,"domain":"garden-diary","view":{"today":"2026-10-16","lines":[{"id":"log-032","text":"The radio says thirty one by morning in the hollow. Sheets over the last of the peppers.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-10-15","writtenAt":"2026-10-15T23:30:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-031","text":"Leeks still standing under the canvas. They will be good until Christmas.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-10-12","writtenAt":"2026-10-12T22:10:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-030","text":"The fountain is drained and the pump is in the cellar for the winter.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-10-09","writtenAt":"2026-10-09T11:50:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-029","text":"Dahlias lifted, washed and drying upside down in the cellar before they go in the crates of peat.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-10-07","writtenAt":"2026-10-07T20:40:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"kg-dahlia","plantingTitle":"Dahlia","plantingLifted":true,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-028","text":"Garlic in along the south wall, four rows, one hundred and twelve cloves of Music.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-10-04","writtenAt":"2026-10-04T21:05:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":"kg-bed-wall","bedName":null,"bedKind":"bed","plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-027","text":"Thirty five at dawn and the dahlia leaves blackened at the edges. Lifting them this week.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-10-02","writtenAt":"2026-10-02T11:25:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-026","text":"The maple by the gate has gone scarlet on one side only.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-09-27","writtenAt":"2026-09-27T13:05:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-025","text":"Started the list of what to do before the frost.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-09-20","writtenAt":"2026-09-20T23:20:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-024","text":"Squash in. Curing on the porch in the sun for a fortnight.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-09-15","writtenAt":"2026-09-15T21:30:00.001Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"kg-butternut","plantingTitle":"Butternut squash","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-023","text":"The coneflowers by the bench are full of bees, and one late monarch.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-09-08","writtenAt":"2026-09-08T22:55:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"demo-00x","plantingTitle":"Coneflower","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-022","text":"First cool morning, fifty one at six. The cosmos does not mind.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-09-02","writtenAt":"2026-09-02T11:40:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-021","text":"The sedum is turning from green to pink. That is how you know August is nearly done.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-08-26","writtenAt":"2026-08-27T00:40:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-020","text":"The paste tomatoes have done better than anything. Sauce on Wednesday.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-08-19","writtenAt":"2026-08-19T22:15:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"kg-paste","plantingTitle":"Paste tomato","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-019","text":"Squash vines over the path and into the next bed. Turned them back by hand.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-08-12","writtenAt":"2026-08-12T11:05:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"kg-butternut","plantingTitle":"Butternut squash","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-018","text":"Black-eyed Susans along the east bed, the brightest thing in the garden.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-08-05","writtenAt":"2026-08-05T23:50:00.001Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-017","text":"The first Café au Lait. Blush and cream and as big as a side plate.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-07-29","writtenAt":"2026-07-29T12:30:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"kg-dahlia","plantingTitle":"Dahlia","plantingLifted":true,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-016","text":"The third day over ninety. Watered everything at dusk and the squash leaves stood up again.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-07-24","writtenAt":"2026-07-25T01:10:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-015","text":"Japanese beetles on the zinnias. Knocked them into soapy water before breakfast.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-07-20","writtenAt":"2026-07-20T11:15:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-014","text":"Lettuces out, they had bolted. Carrots and leeks have the bed to themselves.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-07-16","writtenAt":"2026-07-16T22:20:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":"kg-bed-roots","bedName":null,"bedKind":"bed","plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-013","text":"The delphinium has gone over, staked too late and bent at the knee. Next year in May.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-07-08","writtenAt":"2026-07-09T00:30:00.001Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"demo-016","plantingTitle":"Delphinium","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-012","text":"Rain overnight, an inch in the gauge by the gate.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-07-02","writtenAt":"2026-07-02T10:45:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-011","text":"First flowers on the cherry tomatoes.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-06-26","writtenAt":"2026-06-26T23:40:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"kg-cherry","plantingTitle":"Tomato","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-010","text":"The lavender hedge is humming with bees by seven.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-06-20","writtenAt":"2026-06-20T11:35:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-009","text":"A wren is nesting in the arbor. We are leaving the clippers alone on that side.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":true,"aboutOn":"2026-06-14","writtenAt":"2026-06-15T01:00:00.001Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-008","text":"The peonies are open. Pale pink, the scent all along the path.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-06-09","writtenAt":"2026-06-09T12:10:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"demo-00d","plantingTitle":"Peony","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-007","text":"Dahlia tubers in, six of them, eyes up, a hand deep.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":false,"aboutOn":"2026-06-05","writtenAt":"2026-06-05T22:30:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"kitchen-garden","gardenName":"the kitchen garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"kg-dahlia","plantingTitle":"Dahlia","plantingLifted":true,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-006","text":"Everything out. Ten tomatoes, four peppers, and the basil in a 