{"ok":true,"domain":"garden-diary","view":{"today":"2026-10-16","lines":[{"id":"log-032","text":"The radio says thirty one by morning in the hollow. Sheets over the last of the peppers.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":true,"aboutOn":"2026-10-15","writtenAt":"2026-10-15T23:30:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-030","text":"The fountain is drained and the pump is in the cellar for the winter.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":false,"aboutOn":"2026-10-09","writtenAt":"2026-10-09T11:50:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-026","text":"The maple by the gate has gone scarlet on one side only.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":false,"aboutOn":"2026-09-27","writtenAt":"2026-09-27T13:05:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-023","text":"The coneflowers by the bench are full of bees, and one late monarch.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":true,"aboutOn":"2026-09-08","writtenAt":"2026-09-08T22:55:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"demo-00x","plantingTitle":"Coneflower","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-021","text":"The sedum is turning from green to pink. That is how you know August is nearly done.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":true,"aboutOn":"2026-08-26","writtenAt":"2026-08-27T00:40:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-018","text":"Black-eyed Susans along the east bed, the brightest thing in the garden.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":true,"aboutOn":"2026-08-05","writtenAt":"2026-08-05T23:50:00.001Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-013","text":"The delphinium has gone over, staked too late and bent at the knee. Next year in May.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":true,"aboutOn":"2026-07-08","writtenAt":"2026-07-09T00:30:00.001Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"demo-016","plantingTitle":"Delphinium","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-010","text":"The lavender hedge is humming with bees by seven.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":true,"aboutOn":"2026-06-20","writtenAt":"2026-06-20T11:35:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-009","text":"A wren is nesting in the arbor. We are leaving the clippers alone on that side.","private":false,"writtenBy":"person-seat-b","writtenByName":"Silas","mine":false,"aboutOn":"2026-06-14","writtenAt":"2026-06-15T01:00:00.001Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-008","text":"The peonies are open. Pale pink, the scent all along the path.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":true,"aboutOn":"2026-06-09","writtenAt":"2026-06-09T12:10:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"demo-00d","plantingTitle":"Peony","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-004","text":"Frost on the boards this morning but not on the beds. The wall holds the heat.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":true,"aboutOn":"2026-05-22","writtenAt":"2026-05-22T10:50:00.001Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-001","text":"The shrub roses are leafing out, a fortnight behind the town by the look of the ones on the square.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":true,"aboutOn":"2026-05-15","writtenAt":"2026-05-15T11:20:00.000Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":"demo-005","plantingTitle":"Shrub rose","plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}},{"id":"log-000","text":"Walked the walled garden properly for the first time. The roses along the north wall are old and good, and someone loved the peonies.","private":false,"writtenBy":"person-seat-a","writtenByName":"Nora","mine":true,"aboutOn":"2026-05-13","writtenAt":"2026-05-13T22:40:00.001Z","changedAt":null,"revision":1,"legacy":false,"about":{"gardenId":"demo-garden","gardenName":"a small walled garden","gardenArchived":false,"bedId":null,"bedName":null,"bedKind":null,"plantingId":null,"plantingTitle":null,"plantingLifted":false,"houseplantId":null,"houseplantTitle":null,"houseplantRemoved":false,"spaceId":"back-garden","spaceName":"Back Garden"}}],"more":false,"next":null,"permissions":{"write":false,"private":false},"narrowed":{"garden":"demo-garden","bed":null,"planting":null,"houseplant":null,"hand":null}}}